# Copy this file to .env and fill in real values to leave demo mode.
# With no keys set at all, the app runs entirely in demo mode: a
# deterministic mock LLM and hashing-based embeddings, zero API cost,
# zero external dependency beyond the Docker Compose databases.

# --- LLM ---
# One of: mock | openai | anthropic
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Embeddings ---
# One of: hashing | openai
EMBEDDING_PROVIDER=hashing

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=support_app
MYSQL_PASSWORD=support_app_pw
MYSQL_DATABASE=support_ecommerce

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=supportgraph

# --- Oracle ---
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
ORACLE_USER=support_app
ORACLE_PASSWORD=support_app_pw

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=support_policies

# --- App ---
APP_PORT=8000
